<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CodingSahayi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CodingSahayi"
    xmlns:data="using:CodingSahayi.Data"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Title="CodingSahayi"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="TextMessageTemplate" x:DataType="local:TextMessageModel">
                <Grid HorizontalAlignment="{x:Bind Alignment}" Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{x:Bind BackgroundBrush}" CornerRadius="8" Padding="12" MaxWidth="800">
                        <controls:MarkdownTextBlock 
                            Text="{x:Bind Content, Mode=OneWay}" 
                            TextWrapping="Wrap" 
                            Foreground="White"
                            Background="Transparent"
                            CodeBackground="#202020"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" 
                                Visibility="{x:Bind local:MainWindow.ShowCopyButton(Role), Mode=OneWay}" Margin="0,2,4,0">
                        <Button Content="Copy" Click="CopyMessage_Click" FontSize="11" Padding="8,3" Height="24" 
                                Background="Transparent" BorderThickness="1" BorderBrush="#555555" CornerRadius="4" Foreground="LightGray"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            
            <DataTemplate x:Key="ToolMessageTemplate" x:DataType="local:ToolMessageModel">
                <Grid HorizontalAlignment="{x:Bind Alignment}" Margin="0,5">
                    <Expander MaxWidth="800" HorizontalAlignment="Stretch" Background="{x:Bind BackgroundBrush}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="LightGray"/>
                                <TextBlock Text="{x:Bind ToolName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="10">
                            <TextBlock Text="Arguments:" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Arguments}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#A9B7C6" />
                            <TextBlock Text="Output:" FontWeight="SemiBold" />
                            <Border Background="#1E1E1E" CornerRadius="4" Padding="8">
                                <ScrollViewer MaxHeight="300">
                                    <TextBlock Text="{x:Bind Output, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#A9B7C6" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Expander>
                </Grid>
            </DataTemplate>
            
            <local:ChatMessageTemplateSelector x:Key="MessageSelector"
                TextMessageTemplate="{StaticResource TextMessageTemplate}"
                ToolMessageTemplate="{StaticResource ToolMessageTemplate}" />
        </Grid.Resources>

        <NavigationView x:Name="ProjectNav" IsPaneOpen="True" PaneDisplayMode="Left" SelectionChanged="ProjectNav_SelectionChanged">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="API Metrics" Tag="ApiMetricsPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <NavigationViewItem Content="New Project" Tapped="NewProject_Tapped">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Add" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.PaneFooter>
            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="CodingSahayi">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="12,8" Background="#151515">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WorkspacePathText" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" FontFamily="Consolas" />
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Clear Chat" Click="ClearChat_Click" Background="#0078D4" Foreground="White" BorderThickness="0" CornerRadius="4" Padding="12,6"/>
                <Button Click="NewChat_Click" Background="#333333" Foreground="White" BorderThickness="0" CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="New Chat" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind AppVersion}" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Margin="0,0,4,0"/><TextBlock x:Name="ExecutionTimerText" VerticalAlignment="Center" Margin="15,0" Foreground="LightGray" Text="" />
                <Button Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Settings">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="ChatListView" Grid.Row="2" ItemsSource="{x:Bind ChatHistory}" ItemTemplateSelector="{StaticResource MessageSelector}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border Grid.Row="3" Padding="12,4" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Idle" Foreground="LightGray" FontStyle="Italic" />
        </Border>

        <Border x:Name="MentionPopupBorder" Grid.Row="2" Grid.RowSpan="2" 
                VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                Margin="24,0,0,16" Padding="4" Background="#2D2D2D" 
                CornerRadius="8" BorderBrush="#404040" BorderThickness="1" 
                Visibility="Collapsed" MaxHeight="250" Width="300"
                Canvas.ZIndex="100">
            <ListView x:Name="MentionListView" SelectionMode="Single" 
                      IsItemClickEnabled="True" ItemClick="MentionListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" FontSize="13" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="4" Margin="16" Padding="12" Background="#1E1E1E" CornerRadius="16" BorderBrush="#333333" BorderThickness="1" VerticalAlignment="Bottom">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <ItemsControl x:Name="ContextChipsControl" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="#333333" CornerRadius="4" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <SymbolIcon Symbol="Document" />
                                    <TextBlock Text="{x:Bind}" FontSize="12" Foreground="LightGray" VerticalAlignment="Center" />
                                    <Button Background="Transparent" BorderThickness="0" Padding="0" Width="20" Height="20" 
                                            CommandParameter="{x:Bind}" Click="RemoveContextChip_Click">
                                        <SymbolIcon Symbol="Cancel" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <TextBox x:Name="InputTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                         PlaceholderText="Ask anything, @ to mention, / for actions" 
                         MinHeight="40" MaxHeight="150" 
                         Background="Transparent" BorderThickness="0" 
                         TextChanged="InputTextBox_TextChanged"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown" />
                
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="8">
                                <SymbolIcon Symbol="Add" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Add Context" />
                                        <MenuFlyoutItem Text="Media" />
                                        <MenuFlyoutItem Text="@ Mentions" />
                                        <MenuFlyoutItem Text="Actions" />
                                        <MenuFlyoutItem Text="Browser" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <ComboBox x:Name="ModelSelector" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="MicButton" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="8">
                                <SymbolIcon Symbol="Microphone" />
                            </Button>
                            <Button x:Name="SendButton" Click="SendButton_Click" 
                                    CornerRadius="20" Background="#0078D4" Width="32" Height="32" 
                                    Padding="0" Visibility="Collapsed">
                                <SymbolIcon x:Name="SendIcon" Symbol="Send" Foreground="White" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Frame x:Name="ContentFrame" Grid.Row="1" Grid.RowSpan="4" Background="#151515" Visibility="Collapsed" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
