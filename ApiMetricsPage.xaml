<Page
    x:Class="CodingSahayi.ApiMetricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CodingSahayi"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Metric Cards Strip -->
        <VariableSizedWrapGrid Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Width="150" Margin="0,0,16,16" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock Text="Total Calls" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="TotalCallsText" Text="0" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,16,16" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock Text="Total Tokens" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="TotalTokensText" Text="0" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,16,16" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock Text="Avg Latency" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="AvgLatencyText" Text="0 ms" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,16,16" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock Text="Estimated Cost" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="EstimatedCostText" Text="$0.00" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,16,16" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock Text="Failed Calls" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="FailedCallsText" Text="0" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,16,16" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                <TextBlock Text="Active Providers" FontSize="12" Foreground="Gray" />
                <TextBlock x:Name="ActiveProvidersText" Text="0" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
        </VariableSizedWrapGrid>

        <!-- Control & Filter Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" Spacing="16">
            <ComboBox x:Name="TimeframeCombo" Header="Timeframe" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All Time" />
                <ComboBoxItem Content="Last 24 Hours" />
                <ComboBoxItem Content="Last 7 Days" />
            </ComboBox>
            <ComboBox x:Name="StatusCombo" Header="Status" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Success" />
                <ComboBoxItem Content="Error" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Header="Search Prompt/Response" Width="250" TextChanged="OnSearchTextChanged" />
        </StackPanel>

        <!-- Real-Time Request Logs Table -->
        <ListView x:Name="LogsList" Grid.Row="2" SelectionMode="None">
            <ListView.Header>
                <Grid Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Timestamp" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Provider" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Model" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Latency" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="Prompt Snippet" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="Action" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Provider}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Model}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding LatencyMs}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding PromptSnippet}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="5" Content="Inspect" Click="InspectButton_Click" Tag="{Binding Id}" HorizontalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
