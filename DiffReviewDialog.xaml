<ContentDialog
    x:Class="CodingSahayi.DiffReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review Changes"
    PrimaryButtonText="Commit Approved Changes"
    SecondaryButtonText="Cancel">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0">
            <ItemsControl x:Name="OldLinesControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1">
            <ItemsControl x:Name="NewLinesControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" Grid.Column="0" />
                            <!-- A simple representation since we don't have a complex viewmodel -->
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <Button Content="✓" Click="AcceptButton_Click" />
                                <Button Content="✗" Click="RejectButton_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
